# GetVirtu — environment variables template
# Copy to .env for local development. NEVER commit real values. In production, set them in
# Vercel > Project > Settings > Environment Variables (type "Sensitive" for every secret).

# ===== Security (REQUIRED in production) =====
# Session signing key — long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Administrator password, stored as a scrypt hash ONLY (never the plain password):
#   node scripts/hash-password.js
# Applied once per distinct value: it bootstraps the first password and serves as break-glass recovery
# (set a new hash + redeploy to reset a forgotten admin password). Changes made in the dashboard are kept.
ADMIN_PASSWORD_HASH=
# Optional: administrator e-mail used when the admin account is first created (default admin@getvirtu.shop)
ADMIN_EMAIL=

# ===== Database (recommended) =====
# Postgres connection string (Vercel > Storage > Neon or Supabase sets DATABASE_URL / POSTGRES_URL automatically).
# Without it, production falls back to Vercel Edge Config (EDGE_CONFIG_ID + VERCEL_TOKEN), which has no transactions.
DATABASE_URL=
# Optional TLS settings: PG_SSL_CA=<CA certificate PEM> to verify the server certificate
# Local development always uses data/database.json unless GV_STORE=postgres is set explicitly.

# ===== Legacy storage (temporary, until DATABASE_URL exists) =====
EDGE_CONFIG_ID=
VERCEL_TEAM_ID=
VERCEL_TOKEN=

# ===== SasPay (Mobile Money) =====
SASPAY_API_KEY=
SASPAY_BASE_URL=https://api.saspay.me/api/v1
# Optional: HMAC secret of SasPay webhooks (payments are re-verified with the SasPay API in any case)
SASPAY_WEBHOOK_SECRET=

# ===== Trybit (crypto) =====
TRYBIT_API_KEY=
TRYBIT_SHOP_ID=
TRYBIT_SECRET_KEY=
TRYBIT_SUCCESS_URL=
TRYBIT_FAIL_URL=
TRYBIT_NOTIFICATION_URL=

# ===== Google Sign-In =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://getvirtu.shop/api/auth/google/callback

# ===== Password reset e-mails (optional — without them, customers reset through the support) =====
RESEND_API_KEY=
MAIL_FROM=GetVirtu <no-reply@getvirtu.shop>

# ===== Manual delivery WhatsApp number (international format, no "+") =====
WHATSAPP_NUMBER=237692960840

# Local server port
PORT=3000
