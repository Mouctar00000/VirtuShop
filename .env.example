# GetVirtu Environment Variables Template
# Copiez ce fichier vers .env et renseignez vos clés réelles
# Attention : Ne commitez jamais de clés secrètes réelles sur GitHub

# Passerelle SasPay (Paiements Mobile Money)
SASPAY_API_KEY=
SASPAY_BASE_URL=https://api.saspay.me/api/v1
PORT=3000

# Google Identity Services / OAuth 2.0 (Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://getvirtu.shop/api/auth/google/callback

# Passerelle Crypto Trybit (Paiements USDT, BTC, ETH, LTC...)
# Identifiants serveur officiels (Ne jamais exposer au client ou dans NEXT_PUBLIC_)
TRYBIT_API_KEY=
TRYBIT_SHOP_ID=
TRYBIT_SECRET_KEY=

# URLs publiques pour Trybit (Configurables également dans le tableau de bord Trybit)
NEXT_PUBLIC_TRYBIT_SUCCESS_URL=
NEXT_PUBLIC_TRYBIT_FAIL_URL=
NEXT_PUBLIC_TRYBIT_NOTIFICATION_URL=

# URLs serveur pour Trybit
TRYBIT_SUCCESS_URL=
TRYBIT_FAIL_URL=
TRYBIT_NOTIFICATION_URL=
