{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "regions": ["cdg1"],
  "functions": {
    "api/*.js": { "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/payments/saspay/reconcile", "schedule": "0 6 * * *" }
  ],
  "redirects": [
    { "source": "/data/:path*", "destination": "/", "permanent": false },
    { "source": "/backend/:path*", "destination": "/", "permanent": false },
    { "source": "/tests/:path*", "destination": "/", "permanent": false },
    { "source": "/scripts/:path*", "destination": "/", "permanent": false },
    { "source": "/docs/:path*", "destination": "/", "permanent": false },
    { "source": "/node_modules/:path*", "destination": "/", "permanent": false },
    { "source": "/package.json", "destination": "/", "permanent": false },
    { "source": "/package-lock.json", "destination": "/", "permanent": false },
    { "source": "/server.js", "destination": "/", "permanent": false },
    { "source": "/version.json", "destination": "/api/version", "permanent": false },
    { "source": "/vercel.json", "destination": "/", "permanent": false },
    { "source": "/README.md", "destination": "/", "permanent": false },
    { "source": "/CNAME", "destination": "/", "permanent": false },
    { "source": "/(\\.env.*|\\.git.*|\\.vercel.*)", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/api/version", "destination": "/api/data?resource=version" },
    { "source": "/media/:id", "destination": "/api/data?resource=media&id=:id" },
    { "source": "/api/auth/:path*", "destination": "/api/auth" },
    { "source": "/api/payments/:path*", "destination": "/api/payments" },
    { "source": "/api/data/:path*", "destination": "/api/data" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://accounts.google.com https://oauth2.googleapis.com; frame-src https://accounts.google.com; form-action 'self' https://accounts.google.com; base-uri 'self'; object-src 'none'; frame-ancestors 'self'" }
      ]
    },
    {
      "source": "/(index\\.html|admin\\.html|admin|)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(favicon\\.ico|favicon\\.svg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
